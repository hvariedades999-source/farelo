{
  "name": "farelo",
  "productName": "Farelo",
  "version": "1.0.0",
  "description": "Farelo",
  "author": "Farelo",
  "main": "main.js",
  "private": true,
  "scripts": {
    "web": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win nsis --publish never",
    "test": "node test/e2e.js"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "playwright-core": "1.49.1"
  },
  "build": {
    "appId": "com.farelo.app",
    "productName": "Farelo",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json", "web/**/*", "build/icon.png", "build/drag.png"],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Farelo",
      "artifactName": "Farelo-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      { "ext": ["wav", "mp3", "ogg", "flac", "m4a"], "name": "Audio", "description": "Arquivo de áudio", "role": "Editor" }
    ],
    "publish": [{ "provider": "github", "owner": "hvariedades999-source", "repo": "farelo" }]
  }
}
